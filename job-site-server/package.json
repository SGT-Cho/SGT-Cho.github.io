{
  "name": "job-site-refactored",
  "version": "2.0.0",
  "description": "Enhanced job posting site with improved architecture",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "start:legacy": "node server.js",
    "dev": "nodemon server/app.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "test": "jest",
